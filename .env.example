# ---------------------------------------------------------------------------
# N1 (Nord) exchange connection — LOCAL DEV TEMPLATE ONLY
#
# Every value below is a PLACEHOLDER. None of it is a real credential.
# Copy this file to `.env` yourself, in a plain terminal, and fill in real
# values by hand. Per SPEC.md Section 9.1: never let an AI coding session
# touch the real private key or a real .env file.
# ---------------------------------------------------------------------------

# TODO(you): N1's base API URL. The nord-ts SDK does not ship a public
# testnet/staging URL (only an internal localhost dev default), so this has
# to come from N1 directly — do not guess it.
N1_WEB_SERVER_URL=https://REPLACE_ME.example.invalid

# TODO(you): the "app" verification key N1 issues per integrating application.
N1_APP_ADDR=REPLACE_ME_FAKE_APP_ADDR

# Solana RPC endpoint, used for deposit/withdraw operations only.
# The public mainnet endpoint below is not a secret and is fine as a default,
# but consider a dedicated RPC provider once this is more than local dev.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# TODO(you): your N1 account's private key. NEVER paste a real key into a
# file an AI session can read or write. This placeholder is intentionally
# not a valid key.
N1_PRIVATE_KEY=FAKE_PLACEHOLDER_DO_NOT_USE_0000000000000000000000000000


# ---------------------------------------------------------------------------
# Operational alerting (Telegram) — OPTIONAL
#
# Not a trading credential: this bot only ever sends outbound notifications
# (fills, reconciliation degraded/recovered, halted/resumed) to this chat. If
# either var below is unset, alerting is silently disabled (logged once at
# startup) and every paper-mode entrypoint script still runs normally.
# ---------------------------------------------------------------------------

# TODO(you): a Telegram bot token from @BotFather. Placeholder only, not real.
TELEGRAM_BOT_TOKEN=REPLACE_ME_FAKE_TELEGRAM_BOT_TOKEN

# TODO(you): the chat id (or channel id) the bot should post alerts into.
TELEGRAM_CHAT_ID=REPLACE_ME_FAKE_TELEGRAM_CHAT_ID
N1_PRIVATE_KEY=  # your N1 wallet private key — never commit a real value here
