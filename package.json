{
  "name": "riimtrool",
  "version": "0.0.1",
  "private": true,
  "description": "Unified multi-market, multi-exchange perp trading bot (N1 first). See SPEC.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dashboard:sidecar": "tsx scripts/run-dashboard-sidecar.ts",
    "dashboard:preview": "tsx scripts/run-dashboard-preview.ts",
    "risex:preflight": "tsx scripts/run-risex-live.ts --preflight-only",
    "risex:live": "tsx scripts/run-risex-live.ts --i-understand-this-places-real-orders",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@n1xyz/nord-ts": "^0.7.4",
    "@solana/web3.js": "^1.98.4",
    "ethers": "^6.15.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
